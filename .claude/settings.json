{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-build-while-dev.mjs\"",
            "timeout": 10,
            "statusMessage": "Проверяю, не занят ли порт дев-сервера"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/applied-migration-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Проверяю, не применена ли уже миграция"
          }
        ]
      }
    ]
  }
}
