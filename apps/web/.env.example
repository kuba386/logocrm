# Облачный проект: значения на странице Project Settings → API
# Локальный стек: значения печатает `supabase start` в packages/db
NEXT_PUBLIC_SUPABASE_URL=
# Новый формат ключа — sb_publishable_…; для старых проектов подойдёт
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Приложение читает оба, достаточно одного.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Ассистент (0064): ключ OpenAI — только на сервере, заводит владелец платформы
# (Vercel → Environment Variables). Без него /app/assistant говорит «не настроен».
OPENAI_API_KEY=
# Капча Cloudflare Turnstile (только prod): ключ САЙТА, не секрет — секрет
# вводится в Supabase (Authentication → Attack Protection). Не задан — виджета
# нет и формы работают как раньше (staging, локально, e2e). Тестовый ключ,
# который всегда проходит: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Sentry (только prod, Vercel-проект logocrm-prod): DSN не секрет — он и так
# виден в браузере. Не задан — Sentry выключен (staging, локально, e2e).
NEXT_PUBLIC_SENTRY_DSN=
